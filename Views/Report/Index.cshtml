@model SqlDataImporter.Models.ConnectionRequest

@{
    ViewData["Title"] = "Reportes dinámicos";
}

<link rel="stylesheet" href="~/css/SqlConnection.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/ReportBuilder.css" asp-append-version="true" />

<div class="hy-wrapper">

    <partial name="_SqlTargetSelector"
             model="Model" />


    <div id="reportBuilderSection"
         class="d-none report-builder-wide"
         data-columns-url="@Url.Action("GetColumns", "Connection")"
         data-tables-url="@Url.Action("GetTables", "Connection")"
         data-preview-url="@Url.Action("Preview", "Report")"
         data-export-excel-url="@Url.Action("ExportExcel", "Report")"
         data-export-csv-url="@Url.Action("ExportCsv", "Report")">

        <div class="report-builder-stack">

            <!-- ==========================================
                 TABLA PRINCIPAL
                 ========================================== -->
            <div class="hy-card mt-4">

                <div class="hy-card-header">
                    <div class="hy-eyebrow">Constructor de reportes</div>
                    <h4 class="hy-title">Diseñar reporte</h4>
                </div>

                <div class="hy-accent-bar"></div>

                <div class="hy-card-body">

                    <div class="report-section">

                        <div class="report-section-header">
                            <div class="report-section-heading">
                                <span class="report-section-icon">
                                    <i class="fa fa-database" aria-hidden="true"></i>
                                </span>
                                <div>
                                    <div class="report-section-title">Tabla principal</div>
                                    <div class="text-muted small">
                                        Base de datos y tabla sobre la que se construye el reporte.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="report-target">

                            <div>
                                <div class="text-muted small">Base de datos</div>
                                <div id="reportDatabase" class="fw-semibold"></div>
                            </div>

                            <div>
                                <div class="text-muted small">Tabla</div>
                                <div id="reportTable" class="fw-semibold"></div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ==========================================
                 COLUMNAS
                 ========================================== -->
            <div class="hy-card">

                <div class="hy-card-body">

                    <div class="report-section">

                        <div class="report-section-header">
                            <div class="report-section-heading">
                                <span class="report-section-icon">
                                    <i class="fa fa-list-check" aria-hidden="true"></i>
                                </span>
                                <div>
                                    <div class="report-section-title">Columnas del reporte</div>
                                    <div class="text-muted small">
                                        Seleccione las columnas que desea incluir en el resultado.
                                    </div>
                                </div>
                            </div>

                            <div class="report-section-actions report-column-actions">

                                <button type="button"
                                        id="btnSelectAllColumns"
                                        class="btn btn-sm btn-outline-secondary">
                                    Seleccionar todas
                                </button>

                                <button type="button"
                                        id="btnClearColumns"
                                        class="btn btn-sm btn-outline-secondary">
                                    Limpiar
                                </button>

                            </div>

                        </div>


                        <div id="reportColumnsLoading"
                             class="text-muted small py-3 d-none">
                            Cargando columnas...
                        </div>


                        <div id="reportColumns"
                             class="report-columns">
                        </div>


                        <div id="reportColumnsEmpty"
                             class="alert alert-light border mt-3 d-none">
                            No se encontraron columnas para la tabla seleccionada.
                        </div>

                    </div>

                </div>

            </div>

            <!-- ==========================================
                 SECCIONES AVANZADAS (ACORDEÓN)
                 Relaciones / Filtros / Columnas combinadas
                 ========================================== -->
            <div class="hy-card">

                <div class="hy-card-body">

                    <div class="report-section-header mb-3">
                        <div class="report-section-heading">
                            <span class="report-section-icon">
                                <i class="fa fa-sliders" aria-hidden="true"></i>
                            </span>
                            <div>
                                <div class="report-section-title">Opciones avanzadas</div>
                                <div class="text-muted small">
                                    Relaciones, filtros, métricas, columnas condicionales
                                    y columnas combinadas son opcionales.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="accordion report-advanced-accordion" id="reportAdvancedAccordion">

                        <!-- RELACIONES / JOINS -->
                        <div class="accordion-item">

                            <h2 class="accordion-header">
                                <button type="button"
                                        class="accordion-button collapsed"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseJoins">

                                    Relaciones
                                    <span class="badge report-count-badge ms-2" id="joinsCountBadge">0</span>

                                </button>
                            </h2>

                            <div id="collapseJoins"
                                 class="accordion-collapse collapse"
                                 data-bs-parent="#reportAdvancedAccordion">

                                <div class="accordion-body">

                                    <div class="d-flex
                                        justify-content-between
                                        align-items-center
                                        mb-3">

                                        <div class="text-muted small">
                                            Agregue tablas relacionadas al reporte.
                                        </div>

                                        <button type="button" id="btnAddJoin" class="btn btn-sm btn-outline-primary">
                                            <i class="fa fa-plus" aria-hidden="true"></i>
                                            Agregar relación
                                        </button>

                                    </div>

                                    <div id="reportJoins">
                                    </div>

                                    <div id="reportJoinsEmpty" class="alert alert-light border">
                                        El reporte actualmente utiliza solamente la tabla principal.
                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- FILTROS -->
                        <div class="accordion-item">

                            <h2 class="accordion-header">
                                <button type="button"
                                        class="accordion-button collapsed"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseFilters">

                                    Filtros
                                    <span class="badge report-count-badge ms-2" id="filtersCountBadge">0</span>

                                </button>
                            </h2>

                            <div id="collapseFilters"
                                 class="accordion-collapse collapse"
                                 data-bs-parent="#reportAdvancedAccordion">

                                <div class="accordion-body">

                                    <div class="d-flex
                                        justify-content-between
                                        align-items-center
                                        mb-3">

                                        <div class="text-muted small">
                                            Defina las condiciones WHERE del reporte.
                                        </div>

                                        <button type="button" id="btnAddFilter" class="btn btn-sm btn-outline-primary">
                                            <i class="fa fa-plus" aria-hidden="true"></i>
                                            Agregar filtro
                                        </button>

                                    </div>

                                    <div id="reportFilters">
                                    </div>

                                    <div id="reportFiltersEmpty"
                                         class="alert alert-light border">
                                        No se han agregado filtros.
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- ==========================================
                         MÉTRICAS Y CÁLCULOS
                         ========================================== -->
                        <div class="accordion-item">

                            <h2 class="accordion-header">

                                <button type="button"
                                        class="accordion-button collapsed"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseMetrics">

                                    Métricas y cálculos

                                    <span class="badge report-count-badge ms-2" id="metricsCountBadge">
                                        0
                                    </span>

                                </button>

                            </h2>

                            <div id="collapseMetrics"
                                 class="accordion-collapse collapse"
                                 data-bs-parent="#reportAdvancedAccordion">

                                <div class="accordion-body">

                                    <div class="d-flex
                                        justify-content-between
                                        align-items-center
                                        mb-3">

                                        <div>
                                            <div class="fw-semibold">
                                                Columnas calculadas
                                            </div>

                                            <div class="text-muted small">
                                                Cree sumas, conteos, promedios y otros
                                                cálculos sobre la información del reporte.
                                            </div>
                                        </div>

                                        <button type="button"
                                                id="btnAddMetric"
                                                class="btn btn-sm btn-outline-primary">

                                            <i class="fa fa-plus"></i>
                                            Agregar métrica

                                        </button>

                                    </div>

                                    <div id="reportMetrics">
                                    </div>

                                    <div id="reportMetricsEmpty"
                                         class="alert alert-light border">

                                        No se han agregado métricas o cálculos.

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- ==========================================
                         COLUMNAS CONDICIONALES / CASE WHEN
                         ========================================== -->
                        <div class="accordion-item">

                            <h2 class="accordion-header">

                                <button type="button"
                                        class="accordion-button collapsed"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseConditionalColumns">

                                    Columnas condicionales

                                    <span class="badge report-count-badge ms-2"
                                          id="conditionalColumnsCountBadge">
                                        0
                                    </span>

                                </button>

                            </h2>


                            <div id="collapseConditionalColumns"
                                 class="accordion-collapse collapse"
                                 data-bs-parent="#reportAdvancedAccordion">

                                <div class="accordion-body">


                                    <!-- ==========================================
                                     CABECERA
                                     ========================================== -->
                                    <div class="d-flex
                                        justify-content-between
                                        align-items-center
                                        mb-3">

                                        <div>

                                            <div class="fw-semibold">
                                                Columnas CASE WHEN
                                            </div>

                                            <div class="text-muted small">
                                                Cree columnas calculadas mediante condiciones
                                                WHEN, resultados THEN y un valor ELSE.
                                            </div>

                                        </div>


                                        <button type="button"
                                                id="btnAddConditionalColumn"
                                                class="btn btn-sm btn-outline-primary">

                                            <i class="fa fa-plus"></i>

                                            Agregar columna condicional

                                        </button>

                                    </div>


                                    <!-- ==========================================
                                     CONTENEDOR DINÁMICO
                                     ========================================== -->
                                    <div id="reportConditionalColumns"></div>

                                    <!-- ==========================================
                                     ESTADO VACÍO
                                     ========================================== -->
                                    <div id="reportConditionalColumnsEmpty" class="alert alert-light border">
                                        No se han agregado columnas condicionales.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- COLUMNAS COMBINADAS -->
                        <div class="accordion-item">

                            <h2 class="accordion-header">
                                <button type="button"
                                        class="accordion-button collapsed"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseConcat">

                                    Columnas combinadas
                                    <span class="badge report-count-badge ms-2" id="concatCountBadge">0</span>

                                </button>
                            </h2>

                            <div id="collapseConcat"
                                 class="accordion-collapse collapse"
                                 data-bs-parent="#reportAdvancedAccordion">

                                <div class="accordion-body">

                                    <div class="d-flex
                                        justify-content-between
                                        align-items-center
                                        mb-3">

                                        <div class="text-muted small">
                                            Combine varias columnas en un solo campo del reporte.
                                        </div>

                                        <button type="button"
                                                id="btnAddConcatColumn"
                                                class="btn btn-sm btn-outline-primary">
                                            <i class="fa fa-plus"></i>
                                            Agregar columna combinada
                                        </button>

                                    </div>

                                    <div id="reportConcatColumns">
                                    </div>

                                    <div id="reportConcatColumnsEmpty"
                                         class="alert alert-light border">
                                        No se han agregado columnas combinadas.
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ==========================================
                 VISTA PREVIA
                 ========================================== -->
            <div id="reportPreviewSection" class="hy-card report-preview-card d-none">

                <div class="hy-card-body p-0">

                    <div class="report-preview-header">

                        <div>
                            <div class="report-section-title">Vista previa</div>
                            <div id="reportPreviewInfo" class="text-muted small"></div>
                        </div>

                    </div>


                    <div class="table-responsive report-preview-table-wrapper">

                        <table class="table report-preview-table">

                            <thead id="reportPreviewHead">
                            </thead>

                            <tbody id="reportPreviewBody">
                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        <!-- ==========================================
     BARRA DE ACCIONES (STICKY)
     ========================================== -->
        <div class="report-actions-bar">

            <div class="report-name-row">

                <label for="reportName" class="report-field-label mb-0">
                    Nombre del reporte
                </label>

                <input type="text"
                       id="reportName"
                       class="form-control report-name-input"
                       placeholder="Ej. Reporte de clientes" />

            </div>

            <div class="report-actions-row">

                <div class="report-selection-summary">

                    <div>
                        <div class="text-muted small">Columnas seleccionadas</div>
                        <div id="selectedColumnsCount" class="fw-bold">0</div>
                    </div>

                    <div id="selectedColumnsText" class="text-muted small">
                        Seleccione al menos una columna.
                    </div>

                </div>

                <div class="report-actions">

                    <button type="button"
                            id="btnPreviewReport"
                            class="btn btn-outline-secondary"
                            disabled>
                        Vista previa
                    </button>

                    <button type="button"
                            id="btnExportExcel"
                            class="btn hy-btn-primary"
                            disabled>
                        Exportar Excel
                    </button>

                    <button type="button"
                            id="btnExportCsv"
                            class="btn btn-outline-secondary"
                            disabled>
                        Exportar CSV
                    </button>

                </div>

            </div>

        </div>

</div>

@section Scripts {
    <script src="~/js/sql-target-selector.js" asp-append-version="true"></script>
    <script src="~/js/report-builder.js" asp-append-version="true"></script>
}